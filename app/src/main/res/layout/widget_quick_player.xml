<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_quick_player_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <!-- Vinyl Album Icon -->
    <ImageView
        android:id="@+id/widget_album_art"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginEnd="10dp"
        android:contentDescription="Cover"
        android:scaleType="centerInside"
        android:src="@drawable/ic_vinyl" />

    <!-- Track Details (Click to open app) -->
    <LinearLayout
        android:id="@+id/widget_info_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_track_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Kein Track geladen"
            android:textColor="#FFFFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_track_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Pioneer DJ Deck A • Bereit"
            android:textColor="#FF00E5FF"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Playback Controls -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Previous Track Button -->
        <ImageButton
            android:id="@+id/widget_btn_prev"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/widget_button_bg"
            android:contentDescription="Vorheriger Track"
            android:padding="6dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_skip_previous" />

        <!-- Play / Pause Button -->
        <ImageButton
            android:id="@+id/widget_btn_play_pause"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/widget_button_play_bg"
            android:contentDescription="Play Pause"
            android:padding="8dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_play" />

        <!-- Next Track Button -->
        <ImageButton
            android:id="@+id/widget_btn_next"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/widget_button_bg"
            android:contentDescription="Nächster Track"
            android:padding="6dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_skip_next" />
    </LinearLayout>

</LinearLayout>
