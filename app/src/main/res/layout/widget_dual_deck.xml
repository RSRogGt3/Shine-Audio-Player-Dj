<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_dual_deck_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_deck_background"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Top Bar: Branding & Quick Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="monospace"
            android:text="DJM PRO CONSOLE"
            android:textColor="#FFFFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- CUE Button -->
        <Button
            android:id="@+id/widget_btn_cue_a"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/widget_button_bg"
            android:fontFamily="monospace"
            android:minWidth="0dp"
            android:paddingHorizontal="8dp"
            android:paddingVertical="0dp"
            android:text="CUE A"
            android:textColor="#FFFFB300"
            android:textSize="10sp"
            android:textStyle="bold" />

        <!-- BEAT SYNC Button -->
        <Button
            android:id="@+id/widget_btn_sync"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:background="@drawable/widget_button_sync_bg"
            android:fontFamily="monospace"
            android:minWidth="0dp"
            android:paddingHorizontal="8dp"
            android:paddingVertical="0dp"
            android:text="SYNC"
            android:textColor="#FF000000"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Dual Deck Section: Deck A & Deck B -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <!-- DECK A CARD -->
        <LinearLayout
            android:id="@+id/widget_deck_a_container"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/widget_button_bg"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:padding="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="DECK A"
                    android:textColor="#FF00E5FF"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_deck_a_bpm"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:text="128 BPM"
                    android:textColor="#FFFFFFFF"
                    android:textSize="10sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/widget_deck_a_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Deck A Bereit"
                android:textColor="#FFFFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/widget_btn_play_a"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/widget_button_play_bg"
                    android:contentDescription="Deck A Play"
                    android:padding="6dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_play" />
            </LinearLayout>
        </LinearLayout>

        <!-- DECK B CARD -->
        <LinearLayout
            android:id="@+id/widget_deck_b_container"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/widget_button_bg"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:padding="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="DECK B"
                    android:textColor="#FFFF007F"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_deck_b_bpm"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:text="128 BPM"
                    android:textColor="#FFFFFFFF"
                    android:textSize="10sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/widget_deck_b_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Deck B Bereit"
                android:textColor="#FFFFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/widget_btn_play_b"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/widget_button_deck_b_bg"
                    android:contentDescription="Deck B Play"
                    android:padding="6dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_play" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
